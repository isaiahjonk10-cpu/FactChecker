# Server-side secrets only. These are read by the /api serverless functions
# (Node.js), never bundled into the browser code — that's what keeps them
# safe. Do NOT prefix these with VITE_, or Vite will expose them to the
# client bundle, defeating the entire point.

# From your Anthropic Console (console.anthropic.com/settings/keys) — this
# is YOUR key, the one that gets billed for every visitor's usage.
ANTHROPIC_API_KEY=sk-ant-...

# From your Supabase project settings → API. Use the "service_role" key,
# NOT the "anon" key — the service role key is what lets the server bypass
# Row Level Security to read/write usage data. Never expose this to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Client-side variables below ---
# These DO need the VITE_ prefix — Vite only bundles VITE_-prefixed vars
# into the browser code, and only these two are meant to be public. The
# anon key is safe to expose by design (it can only do what your Row Level
# Security policies allow, which for this app's tables is nothing — all
# real reads/writes happen through /api using the service key above).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
